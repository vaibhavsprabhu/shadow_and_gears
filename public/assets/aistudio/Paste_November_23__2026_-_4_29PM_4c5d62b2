<script type="module">
import * as THREE from 'three';
import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';

/* ================= renderer / scene ================= */
const canvas = document.getElementById('c');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.outputColorSpace = THREE.SRGBColorSpace;
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(62, innerWidth / innerHeight, 0.1, 1200);

/* ================= seeded random ================= */
let seed = 20261123;
function rand() { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }
const R = (a, b) => a + rand() * (b - a);
const RI = (a, b) => Math.floor(R(a, b + 1));
const pick = a => a[Math.floor(rand() * a.length)];

/* ================= procedural textures ================= */
const ANISO = renderer.capabilities.getMaxAnisotropy();
function tex(w, h, fn, srgb = true) {
  const c = document.createElement('canvas'); c.width = w; c.height = h;
  const g = c.getContext('2d'); fn(g, w, h);
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping; t.anisotropy = ANISO;
  if (srgb) t.colorSpace = THREE.SRGBColorSpace;
  return t;
}
function shade(hex, a) { const n = parseInt(hex.slice(1), 16); const c = v => Math.max(0, Math.min(255, v + a)); return `rgb(${c(n >> 16)},${c(n >> 8 & 255)},${c(n & 255)})`; }
function noise(g, w, h, n, alpha = .12) { for (let i = 0; i < n; i++) { g.fillStyle = rand() < .5 ? `rgba(0,0,0,${R(0, alpha)})` : `rgba(255,255,255,${R(0, alpha * .7)})`; g.fillRect(R(0, w), R(0, h), R(1, 3), R(1, 3)); } }
function glyph(g, x, y, s, col) {
  g.strokeStyle = col; g.lineWidth = Math.max(1.5, s * .12); g.lineCap = 'round';
  const n = RI(3, 6);
  for (let i = 0; i < n; i++) {
    g.beginPath(); const t = rand();
    if (t < .4) { const yy = y + R(.1, .9) * s; g.moveTo(x + R(.05, .3) * s, yy); g.lineTo(x + R(.7, .95) * s, yy); }
    else if (t < .75) { const xx = x + R(.1, .9) * s; g.moveTo(xx, y + R(.05, .3) * s); g.lineTo(xx, y + R(.7, .95) * s); }
    else { g.moveTo(x + R(.1, .5) * s, y + R(.1, .5) * s); g.lineTo(x + R(.5, .9) * s, y + R(.5, .9) * s); }
    g.stroke();
  }
}
const T = {};
T.wood = tex(256, 256, (g, w, h) => {
  g.fillStyle = '#2e2119'; g.fillRect(0, 0, w, h);
  for (let x = 0; x < w; x += 32) {
    const l = R(-14, 14); g.fillStyle = `rgb(${78 + l | 0},${56 + l * .8 | 0},${41 + l * .6 | 0})`; g.fillRect(x + 1.5, 0, 29, h);
    for (let i = 0; i < 16; i++) { g.strokeStyle = `rgba(20,12,8,${R(.08, .28)})`; g.lineWidth = R(.5, 1.6); g.beginPath(); const xx = x + R(3, 29); g.moveTo(xx, 0); g.bezierCurveTo(xx + R(-3, 3), h * .33, xx + R(-3, 3), h * .66, xx, h); g.stroke(); }
  }
  noise(g, w, h, 900, .14);
});
T.roof = tex(128, 128, (g, w, h) => {
  g.fillStyle = '#2f3237'; g.fillRect(0, 0, w, h);
  for (let y = 0; y < h; y += 16) { const gr = g.createLinearGradient(0, y, 0, y + 16); gr.addColorStop(0, '#5a5f66'); gr.addColorStop(1, '#2a2d31'); g.fillStyle = gr; g.fillRect(0, y, w, 15); for (let x = (y / 16 % 2) * 8; x < w; x += 16) { g.fillStyle = 'rgba(0,0,0,.35)'; g.fillRect(x, y, 1.5, 15); } }
  noise(g, w, h, 300, .15);
});
T.roofG = tex(128, 128, (g, w, h) => {
  g.fillStyle = '#2f3237'; g.fillRect(0, 0, w, h);
  for (let x = 0; x < w; x += 16) { const gr = g.createLinearGradient(x, 0, x + 16, 0); gr.addColorStop(0, '#5d626a'); gr.addColorStop(1, '#26292d'); g.fillStyle = gr; g.fillRect(x, 0, 15, h); }
  noise(g, w, h, 300, .15);
});
T.roofG.repeat.set(9, 5);
function latticeDraw(glow) {
  return (g, w, h) => {
    g.fillStyle = glow ? '#000' : '#2a1e16'; g.fillRect(0, 0, w, h);
    const cols = 4, rows = 3, fw = 7, pw = (w - fw * (cols + 1)) / cols, ph = (h - fw * (rows + 1)) / rows;
    for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
      const x = fw + c * (pw + fw), y = fw + r * (ph + fw);
      if (glow) { g.fillStyle = `rgba(255,${190 + R(0, 40) | 0},${110 + R(0, 50) | 0},${R(.3, 1)})`; g.fillRect(x, y, pw, ph); g.fillStyle = '#000'; }
      else { const gr = g.createLinearGradient(x, y, x + pw, y + ph); gr.addColorStop(0, '#6f7c86'); gr.addColorStop(.5, '#38424c'); gr.addColorStop(1, '#5a656e'); g.fillStyle = gr; g.fillRect(x, y, pw, ph); g.fillStyle = 'rgba(30,22,16,.95)'; }
      g.fillRect(x + pw / 2 - 1, y, 2, ph); g.fillRect(x, y + ph / 2 - 1, pw, 2);
    }
  };
}
T.lattice = tex(128, 128, latticeDraw(false));
T.latticeGlow = tex(128, 128, latticeDraw(true));
const COBBLE = ['#8d9290', '#a08f8a', '#7f8d84', '#a59c8e', '#717d86', '#b39a92', '#8f8a7c', '#6e7a72', '#9aa3a8', '#a68478'];
function stone(g, cx, cy, rx, ry, rot, col, jit) {
  const n = jit.length; g.beginPath();
  for (let i = 0; i < n; i++) { const a = i / n * Math.PI * 2, px = Math.cos(a) * rx * jit[i], py = Math.sin(a) * ry * jit[i]; const X = cx + px * Math.cos(rot) - py * Math.sin(rot), Y = cy + px * Math.sin(rot) + py * Math.cos(rot); i ? g.lineTo(X, Y) : g.moveTo(X, Y); }
  g.closePath(); const gr = g.createRadialGradient(cx - rx * .3, cy - ry * .3, 1, cx, cy, Math.max(rx, ry));
  gr.addColorStop(0, shade(col, 22)); gr.addColorStop(1, shade(col, -28)); g.fillStyle = gr; g.fill();
  g.strokeStyle = 'rgba(0,0,0,.4)'; g.lineWidth = 2; g.stroke();
}
T.cobble = tex(512, 512, (g, w, h) => {
  g.fillStyle = '#34322e'; g.fillRect(0, 0, w, h);
  const rows = 16, cols = 13, dy = h / rows, dx = w / cols;
  for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
    const cx = c * dx + (r % 2) * dx / 2 + R(-4, 4), cy = r * dy + R(-3, 3), rx = R(14, 19), ry = R(11, 15), col = pick(COBBLE), rot = R(0, 3.14), jit = [...Array(RI(7, 9))].map(() => R(.82, 1.08));
    for (const ox of [-w, 0, w]) for (const oy of [-h, 0, h]) if (cx + ox > -30 && cx + ox < w + 30 && cy + oy > -30 && cy + oy < h + 30) stone(g, cx + ox, cy + oy, rx, ry, rot, col, jit);
  }
  for (let i = 0; i < 40; i++) { g.fillStyle = `rgba(70,110,50,${R(.05, .2)})`; g.beginPath(); g.ellipse(R(0, w), R(0, h), R(4, 16), R(3, 10), R(0, 3), 0, 7); g.fill(); }
  noise(g, w, h, 2500, .1);
});
T.stoneWall = tex(256, 256, (g, w, h) => {
  g.fillStyle = '#3a3935'; g.fillRect(0, 0, w, h);
  for (let y = 0; y < h; y += 32) { let x = -R(0, 30); while (x < w) { const bw = R(36, 62), col = pick(['#7a7d78', '#8d8a80', '#6c716d', '#948f86', '#7f857f']); g.fillStyle = col; g.beginPath(); g.roundRect(x + 2, y + 2, bw - 4, 28, 8); g.fill(); g.fillStyle = 'rgba(255,255,255,.08)'; g.fillRect(x + 6, y + 5, bw - 14, 5); x += bw; } }
  for (let i = 0; i < 70; i++) { g.fillStyle = `rgba(${60 + R(0, 30) | 0},${100 + R(0, 40) | 0},45,${R(.15, .45)})`; g.beginPath(); g.ellipse(R(0, w), R(0, h), R(4, 20), R(3, 9), 0, 0, 7); g.fill(); }
  noise(g, w, h, 1500, .14);
});
T.shutter = tex(128, 128, (g, w, h) => { g.fillStyle = '#7b8086'; g.fillRect(0, 0, w, h); for (let y = 0; y < h; y += 6) { g.fillStyle = 'rgba(0,0,0,.35)'; g.fillRect(0, y, w, 1.5); g.fillStyle = 'rgba(255,255,255,.15)'; g.fillRect(0, y + 2, w, 1); } for (let i = 0; i < 30; i++) { g.fillStyle = `rgba(120,70,40,${R(.1, .3)})`; g.fillRect(R(0, w), R(0, h), R(2, 8), R(1, 12)); } });
T.concrete = tex(256, 256, (g, w, h) => { g.fillStyle = '#8f8d86'; g.fillRect(0, 0, w, h); noise(g, w, h, 3000, .12); for (let i = 0; i < 25; i++) { g.fillStyle = `rgba(40,40,35,${R(.04, .12)})`; g.fillRect(R(0, w), R(0, h * .4), R(2, 6), R(40, 160)); } });
T.plaster = tex(256, 256, (g, w, h) => { g.fillStyle = '#d6cfc1'; g.fillRect(0, 0, w, h); noise(g, w, h, 2500, .07); for (let i = 0; i < 12; i++) { g.fillStyle = `rgba(90,80,60,${R(.03, .08)})`; g.fillRect(R(0, w), R(0, h * .3), R(3, 9), R(60, 200)); } });
T.metal = tex(128, 128, (g, w, h) => { for (let x = 0; x < w; x += 8) { const gr = g.createLinearGradient(x, 0, x + 8, 0); gr.addColorStop(0, '#e2e2e2'); gr.addColorStop(.5, '#b5b5b5'); gr.addColorStop(1, '#d4d4d4'); g.fillStyle = gr; g.fillRect(x, 0, 8, h); } noise(g, w, h, 500, .1); });
T.grass = tex(256, 256, (g, w, h) => { g.fillStyle = '#4a6a33'; g.fillRect(0, 0, w, h); for (let i = 0; i < 3500; i++) { g.strokeStyle = `rgba(${R(40, 110) | 0},${R(90, 150) | 0},${R(30, 60) | 0},.6)`; g.beginPath(); const x = R(0, w), y = R(0, h); g.moveTo(x, y); g.lineTo(x + R(-2, 2), y - R(2, 6)); g.stroke(); } });
T.asphalt = tex(256, 256, (g, w, h) => { g.fillStyle = '#3b3d40'; g.fillRect(0, 0, w, h); noise(g, w, h, 4000, .14); });
T.road = tex(256, 256, (g, w, h) => {
  g.fillStyle = '#3b3d40'; g.fillRect(0, 0, w, h); noise(g, w, h, 4000, .14);
  g.fillStyle = 'rgba(230,224,200,.85)'; g.fillRect(0, h / 2 - 3, w * .5, 6);
  g.fillStyle = 'rgba(220,215,195,.7)'; g.fillRect(0, 14, w, 3); g.fillRect(0, h - 17, w, 3);
  for (let i = 0; i < 12; i++) { g.fillStyle = `rgba(0,0,0,${R(.05, .15)})`; g.beginPath(); g.ellipse(R(0, w), R(20, h - 20), R(6, 30), R(3, 10), 0, 0, 7); g.fill(); }
});
T.redSign = tex(64, 192, (g, w, h) => { g.fillStyle = '#c4161f'; g.fillRect(0, 0, w, h); g.strokeStyle = '#fff'; g.lineWidth = 3; g.strokeRect(4, 4, w - 8, h - 8); for (let i = 0; i < 3; i++) glyph(g, 12, 14 + i * 58, 40, '#fff'); });
T.posters = [0, 1, 2, 3, 4, 5].map(() => tex(128, 176, (g, w, h) => {
  g.fillStyle = pick(['#f2c14e', '#e94f37', '#3f88c5', '#f3eee2', '#44bba4', '#e8d5b7']); g.fillRect(0, 0, w, h);
  g.fillStyle = pick(['#1d1d1d', '#c8202a', '#ffffff', '#1f4fa0']); g.fillRect(0, R(10, 50), w, R(26, 44));
  for (let k = 0; k < 4; k++) glyph(g, R(8, 70), R(80, 130), R(26, 40), pick(['#111', '#c8202a', '#fff']));
  for (let i = 0; i < 20; i++) { g.fillStyle = `rgba(255,255,255,${R(.05, .2)})`; g.fillRect(R(0, w), R(0, h), R(2, 30), R(1, 4)); }
  noise(g, w, h, 400, .2);
}));
T.fence = tex(64, 64, (g, w, h) => { g.strokeStyle = 'rgba(170,175,180,1)'; g.lineWidth = 2; for (let i = -64; i < 128; i += 16) { g.beginPath(); g.moveTo(i, 0); g.lineTo(i + 64, 64); g.stroke(); g.beginPath(); g.moveTo(i + 64, 0); g.lineTo(i, 64); g.stroke(); } });
T.stripe = tex(128, 32, (g, w, h) => { g.fillStyle = '#eee'; g.fillRect(0, 0, w, h); g.fillStyle = '#c4161f'; for (let x = -32; x < w + 32; x += 32) { g.beginPath(); g.moveTo(x, 0); g.lineTo(x + 16, 0); g.lineTo(x + 32, h); g.lineTo(x + 16, h); g.fill(); } });
T.water = tex(256, 256, (g, w, h) => { g.fillStyle = '#7f9fa8'; g.fillRect(0, 0, w, h); for (let i = 0; i < 260; i++) { g.strokeStyle = `rgba(255,255,255,${R(.1, .45)})`; g.lineWidth = R(.5, 2); g.beginPath(); const x = R(0, w), y = R(0, h); g.moveTo(x, y); g.quadraticCurveTo(x + 8, y - 3, x + R(10, 26), y); g.stroke(); } });
T.water.repeat.set(60, 30);
T.smoke = tex(64, 64, (g, w, h) => { const gr = g.createRadialGradient(32, 32, 2, 32, 32, 30); gr.addColorStop(0, 'rgba(90,90,90,.9)'); gr.addColorStop(1, 'rgba(90,90,90,0)'); g.fillStyle = gr; g.fillRect(0, 0, w, h); });
function textTex(text, bg, fg, w = 1024, h = 160, border) {
  return tex(w, h, g => {
    g.fillStyle = bg; g.fillRect(0, 0, w, h);
    if (border) { g.strokeStyle = border; g.lineWidth = 8; g.strokeRect(8, 8, w - 16, h - 16); }
    let size = h * .55; g.font = `900 ${size}px Impact, 'Arial Black', sans-serif`;
    while (g.measureText(text).width > w * .9) { size -= 4; g.font = `900 ${size}px Impact, 'Arial Black', sans-serif`; }
    g.fillStyle = fg; g.textAlign = 'center'; g.textBaseline = 'middle'; g.fillText(text, w / 2, h / 2 + 3);
  });
}
function skyTex(top, mid, bot) { return tex(4, 256, (g, w, h) => { const gr = g.createLinearGradient(0, 0, 0, h); gr.addColorStop(0, top); gr.addColorStop(.48, mid); gr.addColorStop(.52, bot); gr.addColorStop(1, bot); g.fillStyle = gr; g.fillRect(0, 0, w, h); }); }

/* ================= materials ================= */
const std = o => new THREE.MeshStandardMaterial(o);
const MAT = {
  wood: std({ map: T.wood, roughness: .92 }),
  woodDark: std({ map: T.wood, color: 0x7d7068, roughness: .95 }),
  woodWarm: std({ map: T.wood, color: 0xe0b896, roughness: .9 }),
  lattice: std({ map: T.lattice, emissiveMap: T.latticeGlow, emissive: 0xffc27a, emissiveIntensity: .2, roughness: .5 }),
  shutter: std({ map: T.shutter, roughness: .6, metalness: .15 }),
  roof: std({ map: T.roof, roughness: .8 }),
  roofG: std({ map: T.roofG, roughness: .8, flatShading: true }),
  stone: std({ map: T.stoneWall, roughness: .95 }),
  cobble: std({ map: T.cobble, roughness: .9 }),
  concrete: std({ map: T.concrete, roughness: .9 }),
  plaster: std({ map: T.plaster, roughness: .9 }),
  plasterW: std({ map: T.plaster, color: 0xf4f1ea, roughness: .85 }),
  metal: std({ map: T.metal, color: 0x9aa0a6, roughness: .55, metalness: .2 }),
  darkMetal: std({ color: 0x3a3f44, roughness: .55, metalness: .3 }),
