document.getElementById('bNight').onclick = () => setNight(!night);
document.getElementById('bMap').onclick = () => toggleMap();
document.getElementById('bCopy').onclick = async () => {
  const data = { units: 'metres (three.js units), y up, -z = north', spawn: { x: LOCS[0].sx, z: LOCS[0].sz }, locations: LOCS.map(L => ({ id: L.id, name: L.name, levels: L.lv, marker: { x: L.x, y: +L.gy.toFixed(2), z: L.z }, spawn: { x: L.sx, z: L.sz } })), roads: ROADS.map(r => ({ name: r.name, axis: r.a, at: r.c, from: r.from, to: r.to, width: 10 })) };
  const txt = JSON.stringify(data, null, 2);
  try { await navigator.clipboard.writeText(txt); toast('Layout JSON copied ✓'); }
  catch { const cb = document.getElementById('copybox'); cb.style.display = 'flex'; cb.querySelector('textarea').value = txt; cb.querySelector('textarea').select(); }
};

/* ================= 2D map ================= */
const MAPRES = 900, MS = MAPRES / 400;
const mapBg = document.createElement('canvas'); mapBg.width = mapBg.height = MAPRES;
const W2M = (x, z) => [(x + 200) * MS, (z + 200) * MS];
(function drawMapBg() {
  const g = mapBg.getContext('2d');
  g.fillStyle = '#2c2a27'; g.fillRect(0, 0, MAPRES, MAPRES);
  g.fillStyle = '#1d4656'; g.fillRect(0, (165 + 200) * MS, MAPRES, MAPRES);
  const rect = (f, c) => { const [a, b] = W2M(f.x0, f.z0); g.fillStyle = c; g.fillRect(a, b, (f.x1 - f.x0) * MS, (f.z1 - f.z0) * MS); };
  for (const f of FOOT) { if (f.kind === 'hill') rect(f, '#4a5238'); if (f.kind === 'park') rect(f, '#355f34'); if (f.kind === 'harbour') rect(f, '#4a4a46'); if (f.kind === 'pier') rect(f, '#7a5c3e'); if (f.kind === 'alley' || f.kind === 'stairs') rect(f, '#6b5f55'); }
  for (const r of ROADS) { g.fillStyle = '#5b5e63'; if (r.a === 'x') { const [a, b] = W2M(r.from, r.c - 5); g.fillRect(a, b, (r.to - r.from) * MS, 10 * MS); } else { const [a, b] = W2M(r.c - 5, r.from); g.fillRect(a, b, 10 * MS, (r.to - r.from) * MS); } }
  for (const f of FOOT) { if (f.kind === 'b') rect(f, '#7b6a5a'); if (f.kind === 'lmb') rect(f, '#a89a86'); }
  rect({ x0: 128, x1: 137, z0: 170.5, z1: 195.5 }, '#e8e8e8');
  g.font = `600 ${11 * MS / 2}px 'Chakra Petch',sans-serif`; g.fillStyle = 'rgba(255,255,255,.45)'; g.textAlign = 'center';
  for (const r of ROADS) { g.save(); if (r.a === 'x') { const [a, b] = W2M(r.from + 30, r.c); g.translate(a, b + 4); } else { const [a, b] = W2M(r.c, r.from + 40); g.translate(a + 4, b); g.rotate(Math.PI / 2); } g.fillText(r.name.toUpperCase(), 0, 0); g.restore(); }
})();
function drawMap(ctx, size, full) {
  const s = size / MAPRES * MS;
  ctx.drawImage(mapBg, 0, 0, size, size);
  for (const L of LOCS) {
    const x = (L.x + 200) * s, y = (L.z + 200) * s, r = full ? 13 : 6;
    ctx.fillStyle = L.color; ctx.beginPath(); ctx.arc(x, y, r, 0, 7); ctx.fill();
    ctx.fillStyle = '#111'; ctx.font = `700 ${full ? 13 : 7}px sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(L.id, x, y + .5);
    if (full) { ctx.font = "600 14px 'Chakra Petch',sans-serif"; ctx.fillStyle = '#fff'; ctx.strokeStyle = 'rgba(0,0,0,.8)'; ctx.lineWidth = 4; const ly = L.z > 150 ? y - 22 : y + 24; ctx.strokeText(L.name, x, ly); ctx.fillText(L.name, x, ly); }
  }
  const px = (P.x + 200) * s, pz = (P.z + 200) * s;
  ctx.save(); ctx.translate(px, pz); ctx.rotate(-P.face + Math.PI);
  const a = full ? 12 : 7; ctx.fillStyle = '#1de9b6'; ctx.strokeStyle = '#000'; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.moveTo(0, -a); ctx.lineTo(a * .7, a * .8); ctx.lineTo(0, a * .4); ctx.lineTo(-a * .7, a * .8); ctx.closePath(); ctx.stroke(); ctx.fill(); ctx.restore();
}
const mc = document.getElementById('mc'), mctx = mc.getContext('2d');
const bigmap = document.getElementById('bigmap'), bc = document.getElementById('bc'), bctx = bc.getContext('2d');
function toggleMap() { bigmap.style.display = bigmap.style.display === 'grid' ? 'none' : 'grid'; }
mc.onclick = toggleMap;
bc.addEventListener('click', e => {
  const r = bc.getBoundingClientRect(), x = (e.clientX - r.left) / r.width * 400 - 200, z = (e.clientY - r.top) / r.height * 400 - 200;
  let best = null, bd = 12; for (const L of LOCS) { const d = Math.hypot(L.x - x, L.z - z); if (d < bd) { bd = d; best = L; } }
  if (best) { teleport(best); bigmap.style.display = 'none'; }
});
bigmap.addEventListener('click', e => { if (e.target === bigmap) bigmap.style.display = 'none'; });

/* ================= smoke at crash ================= */
const smoke = [...Array(16)].map((_, i) => { const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: T.smoke, transparent: true, depthWrite: false, opacity: .6 })); s.userData.t = i / 16 * 4; scene.add(s); return s; });

/* ================= loop ================= */
const coordsEl = document.getElementById('coords');
const tmp = new THREE.Vector3();
let last = performance.now(), time = 0, safeT = 0, nearId = 0;
function update(dt) {
  time += dt;
  // --- movement ---
  let f = 0, s = 0;
  if (keys.KeyW || keys.ArrowUp) f += 1; if (keys.KeyS || keys.ArrowDown) f -= 1;
  if (keys.KeyD || keys.ArrowRight) s += 1; if (keys.KeyA || keys.ArrowLeft) s -= 1;
  if (joy) { s += joy.dx / 50; f -= joy.dy / 50; }
  const fx = -Math.sin(CAM.yaw), fz = -Math.cos(CAM.yaw), rx = Math.cos(CAM.yaw), rz = -Math.sin(CAM.yaw);
  let vx = fx * f + rx * s, vz = fz * f + rz * s; const mag = Math.hypot(vx, vz);
  const run = keys.ShiftLeft || keys.ShiftRight || (joy && Math.hypot(joy.dx, joy.dy) > 45);
  const speed = run ? 13 : 6.5;
  if (mag > 0) { if (mag > 1) { vx /= mag; vz /= mag; } vx *= speed; vz *= speed; const nx = P.x + vx * dt; if (!blocked(nx, P.z, P.y)) P.x = nx; const nz = P.z + vz * dt; if (!blocked(P.x, nz, P.y)) P.z = nz; let da = Math.atan2(vx, vz) - P.face; da = Math.atan2(Math.sin(da), Math.cos(da)); P.face += da * Math.min(1, dt * 12); }
  if ((keys.Space || jumpTouch) && P.onGround) { P.vy = 9.5; P.onGround = false; }
  jumpTouch = false;
  P.vy -= 26 * dt; P.y += P.vy * dt;
  const g = groundAt(P.x, P.z, P.y);
  if (P.y <= g) { P.y = g; P.vy = 0; P.onGround = true; }
  else if (P.onGround && P.y - g < .6 && P.vy <= 0) { P.y = g; P.vy = 0; }
  else P.onGround = false;
  if (P.y < -3) { [P.x, P.y, P.z] = P.safe; P.vy = 0; toast('Splash! Back on dry land.'); }
  safeT += dt; if (safeT > .5 && P.onGround && P.y >= -.1 && P.z < 163) { P.safe = [P.x, P.y, P.z]; safeT = 0; }
  // --- animation ---
  const moving = mag > 0 && P.onGround; P.phase += dt * (run ? 13 : 9) * (moving ? 1 : 0);
  const sw = moving ? Math.sin(P.phase) * (run ? .9 : .6) : 0;
  legL.rotation.x = sw; legR.rotation.x = -sw; armL.rotation.x = -sw * .8; armR.rotation.x = sw * .8;
  if (!P.onGround) { legL.rotation.x = .5; legR.rotation.x = -.3; armL.rotation.x = -1.2; armR.rotation.x = -1.2; }
  player.position.set(P.x, P.y + (moving ? Math.abs(Math.sin(P.phase)) * .06 : 0), P.z); player.rotation.y = P.face;
  // --- camera with collision ---
  const tx = P.x, ty = P.y + 1.7, tz = P.z;
  const cdx = Math.sin(CAM.yaw) * Math.cos(CAM.pitch), cdy = Math.sin(CAM.pitch), cdz = Math.cos(CAM.yaw) * Math.cos(CAM.pitch);
  let dist = CAM.dist;
  for (let d = .6; d <= CAM.dist; d += .4) { const x = tx + cdx * d, y = ty + cdy * d, z = tz + cdz * d; if (COLL.some(c => y < c.h && (c.x1 - c.x0 > 1.2 || c.z1 - c.z0 > 1.2) && x > c.x0 - .2 && x < c.x1 + .2 && z > c.z0 - .2 && z < c.z1 + .2)) { dist = Math.max(.6, d - .5); break; } }
  camera.position.set(tx + cdx * dist, Math.max(ty + cdy * dist, groundAt(tx + cdx * dist, tz + cdz * dist, 999) + .3), tz + cdz * dist);
  camera.lookAt(tx, ty, tz);
  sky.position.copy(camera.position);
  sun.position.set(P.x + 70, P.y + 120, P.z + 45); sun.target.position.set(P.x, P.y, P.z);
  // --- world animation ---
  waterMat.map.offset.set(time * .004, time * .006);
  BOAT.position.y = Math.sin(time * 1.1) * .12; BOAT.rotation.z = Math.sin(time * .8) * .015;
  (BOAT.userData.small || []).forEach(b => { b.position.y = Math.sin(time * 1.3 + b.userData.ph) * .15; b.rotation.z = Math.sin(time + b.userData.ph) * .04; });
  const blink = Math.floor(time * 4) % 2; MAT.sirenR.emissiveIntensity = blink ? 3 : .1; MAT.sirenB.emissiveIntensity = blink ? .1 : 3;
  MAT.beaconRed.emissiveIntensity = Math.floor(time * 1.5) % 2 ? 3 : .2;
  for (const sp of smoke) { const t = (sp.userData.t + time) % 4 / 4; sp.position.set(SMOKE_AT.x + Math.sin(t * 6 + sp.userData.t) * .6, SMOKE_AT.y + t * 9, SMOKE_AT.z + t * 1.5); sp.scale.setScalar(1 + t * 4); sp.material.opacity = (1 - t) * .55; }
  // --- locations ---
  let near = null, nd = 14;
  for (const L of LOCS) {
    const pulse = 1 + Math.sin(time * 3 + L.id) * .08; L.ring.scale.set(pulse, pulse, 1); L.ring.rotation.z = time * .5;
    const d = Math.hypot(P.x - L.x, P.z - L.z); if (d < nd && Math.abs(P.y - L.gy) < 6) { nd = d; near = L; }
  }
  if ((near ? near.id : 0) !== nearId) {
    nearId = near ? near.id : 0; LOCS.forEach(L => L.btn.classList.toggle('near', L === near));
    if (near) { card.style.display = 'block'; card.style.borderColor = near.color; card.querySelector('.n').innerHTML = `<span style="color:${near.color}">${near.id}.</span> ${near.name}`; card.querySelector('.l').textContent = near.lv; card.querySelector('.b').textContent = near.brief; }
    else card.style.display = 'none';
  }
  coordsEl.textContent = `x ${P.x.toFixed(1)} · y ${P.y.toFixed(1)} · z ${P.z.toFixed(1)}`;
}
function updateLabels() {
  const w = innerWidth, h = innerHeight;
  for (const L of LOCS) {
    tmp.set(L.x, L.gy + L.ly, L.z);
    const d = camera.position.distanceTo(tmp); tmp.project(camera);
    if (tmp.z > 1 || d > 260 || Math.abs(tmp.x) > 1.1 || Math.abs(tmp.y) > 1.1) { L.el.style.display = 'none'; continue; }
    L.el.style.display = 'block'; L.el.style.opacity = Math.max(.35, 1 - d / 300);
    L.el.style.transform = `translate(${(tmp.x * .5 + .5) * w}px,${(-tmp.y * .5 + .5) * h}px) translate(-50%,-100%)`;
  }
}
function frame(now) {
  const dt = Math.min(.05, (now - last) / 1000); last = now;
  update(dt);
  renderer.render(scene, camera);
  updateLabels();
  drawMap(mctx, 190, false);
  if (bigmap.style.display === 'grid') drawMap(bctx, 900, true);
  requestAnimationFrame(frame);
}
addEventListener('resize', () => { renderer.setSize(innerWidth, innerHeight); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); });
teleport(LOCS[0]); setNight(false);
window.__ready = true;
requestAnimationFrame(frame);
</script>
