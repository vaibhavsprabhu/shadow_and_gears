  hemi.intensity = n ? .4 : 1.5; hemi.color.set(n ? 0x5a6a9a : 0xcfe0ff);
  sun.intensity = n ? .45 : 2.4; sun.color.set(n ? 0x8fa6ff : 0xffe2b8);
  for (const [m, d, nn] of EMIT) m.emissiveIntensity = n ? nn : d;
